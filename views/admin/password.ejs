<%- include('_head', { title: 'Смена пароля' }) %>
<div class="admin-head"><h1>Смена пароля</h1></div>
<% if (error) { %><p class="notice notice--error"><%- icon('alert') %><%= error %></p><% } %>
<form class="form card admin-form admin-form--narrow" method="post" action="/admin/password">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="field"><label for="cur">Текущий пароль</label><input id="cur" name="current" type="password" autocomplete="current-password" required></div>
  <div class="field"><label for="np">Новый пароль (не короче 10 символов)</label><input id="np" name="new_password" type="password" minlength="10" autocomplete="new-password" required></div>
  <button class="btn btn--primary" type="submit">Сменить пароль</button>
</form>
<%- include('_foot') %>

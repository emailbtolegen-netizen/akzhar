<% const emergency = [['112', 'em_112'], ['101', 'em_101'], ['102', 'em_102'], ['103', 'em_103'], ['104', 'em_104']]; %>
<%- include('partials/head', { title: t('phones_title'), description: t('phones_lead') }) %>

<section class="page-hero">
  <div class="container">
    <h1 class="page-title"><%= t('phones_title') %></h1>
    <p class="lead"><%= t('phones_lead') %></p>
  </div>
</section>

<div class="container">
  <section class="emergency" aria-labelledby="emergency-title">
    <div class="emergency__head">
      <h2 id="emergency-title"><%- icon('alert') %><%= t('phones_emergency') %></h2>
      <p><%= t('phones_emergency_note') %></p>
    </div>
    <div class="emergency__list">
      <% emergency.forEach(function (e) { %>
      <a class="emergency__item" href="tel:<%= e[0] %>"><strong><%= e[0] %></strong><span><%= t(e[1]) %></span></a>
      <% }) %>
    </div>
  </section>

  <div class="phone-search">
    <label class="visually-hidden" for="phone-q"><%= t('phones_search') %></label>
    <%- icon('search') %>
    <input id="phone-q" type="search" enterkeyhint="search" placeholder="<%= t('phones_search') %>" autocomplete="off" data-phone-search>
  </div>

  <% groups.forEach(function (g) { %>
  <section class="phone-group" data-phone-group aria-labelledby="g-<%= g.slug %>">
    <h2 class="section-title section-title--sm" id="g-<%= g.slug %>"><%= p(g, 'name') %></h2>
    <div class="phone-grid">
      <% g.phones.forEach(function (ph) { %><%- include('partials/phone-card', { ph }) %><% }) %>
    </div>
  </section>
  <% }) %>
  <p class="empty-inline" data-phone-empty hidden><%= t('ads_nothing_found') %></p>

  <div class="cta-card cta-card--soft">
    <div><h2><%= t('phones_check_note') %></h2></div>
    <a class="btn btn--primary" href="<%= url('/contacts') %>?topic=correction#form"><%- icon('mail') %><%= t('phones_report_btn') %></a>
  </div>
</div>

<%- include('partials/foot') %>
